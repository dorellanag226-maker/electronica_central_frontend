PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/mi_base_datos
DATABASE_SSL=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_DEVELOPER_USERNAME=soporte
BOOTSTRAP_DEVELOPER_EMAIL=soporte@example.test
BOOTSTRAP_DEVELOPER_PASSWORD=change-this-developer-password
CORS_ORIGIN=http://localhost:5173# Recuperacion de contrasena (CU-22)
PASSWORD_RESET_URL=http://localhost:5173/restablecer-contrasena
PASSWORD_RESET_TTL_MINUTES=30
# SMTP (Gmail: smtp.gmail.com, 587, usuario + contrasena de aplicacion). Vacio = el enlace se escribe en el log (solo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Electronica Central AZ <no-reply@example.test>
# Pasarela de pago Stripe (CU-16). Usar SOLO claves de prueba (sk_test_...). Vacio = cobro en linea deshabilitado.
STRIPE_SECRET_KEY=
# Secreto del webhook (whsec_...): `stripe listen` en local o Developers > Webhooks en el panel.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bob
STRIPE_CHECKOUT_EXPIRES_MINUTES=30
PAYMENT_SUCCESS_URL=http://localhost:5173/pagos/exito
PAYMENT_CANCEL_URL=http://localhost:5173/pagos/cancelado
